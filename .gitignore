## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific Visual Studio workspace
*.user.pref

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vs/*
!.vscode/
!.vscode/*
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Visual Studio binary/PDB files
*.dll
*.exe
*.dll.config
*.pdb
*.cache
*.vs
.vs/
.vscode/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / JetBrains
.idea/
*.sln.iml
*.csproj.meta

# Visual C++ build artifacts
*.opendb
*.VC.db
*.db
*.db-shm
*.db-wal

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
**/project.assets.json
**/project.nuget.cache

# ASP.NET Core / secrets
appsettings.Local.json
appsettings.*.Local.json
*.pfx
*.p12
*.snk
*.key
secrets.json
.env
.env.*
!.env.example

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Database / local data
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf
