{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "PSAcademyBack",
    "Audience": "PSAcademyBackClient",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 14
  },
  "Piston": {
    "BaseUrl": "http://localhost:2000/api/v2/",
    "ApiKey": "",
    "TimeoutSeconds": 15,
    "MaxOutputLength": 8000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedReferenceDataOnStartup": true,
    "CommandTimeoutSeconds": 60,
    "MaxRetryCount": 6,
    "RetryDelaySeconds": 10,
    "MigrationMaxAttempts": 8
  },
  "Https": {
    "Enabled": true
  }
}
